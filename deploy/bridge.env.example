FEISHU_APP_ID=cli_aad1fef1c7b81bda
FEISHU_APP_SECRET=replace_with_secret_in_server_file
FEISHU_VERIFICATION_TOKEN=replace_with_feishu_verification_token
FEISHU_ENCRYPT_KEY=replace_with_feishu_encrypt_key
FEISHU_ALLOWED_CHAT_IDS=oc_a84d5b6ca478220d0a37964b50776edb
FEISHU_IVY_PRIVATE_CHAT_ID=oc_d851c3e986007dc0f97ab582bcb2e7c8
FEISHU_APPROVER_OPEN_IDS=ou_replace_after_identify_approver_callback
FEISHU_VOICE_TRANSCRIPTION_ENABLED=false
FEISHU_OAUTH_ENABLED=false
FEISHU_OAUTH_REDIRECT_URI=https://feishu-codex.aijia.ai/oauth/feishu/callback
FEISHU_OAUTH_TOKEN_KEY_FILE=/app/secrets/feishu-oauth-token-key
FEISHU_OAUTH_SCOPES=auth:user.id:read,offline_access,minutes:minutes.basic:read,minutes:minutes.transcript:export
FEISHU_OAUTH_STALE_EVENT_HOURS=24
WEBHOOK_DEBOUNCE_SECONDS=300
CODEX_COMMAND=codex
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=medium
CODEX_WORKDIR=/app/codex-workdir
CODEX_TIMEOUT_SECONDS=120
CODEX_SUMMARIZER_MODE=fake
WORKER_ENABLED=false
WORKER_LEASE_SECONDS=180
WORKER_POLL_INTERVAL_MS=1000
# Phase 1E remains off until a separate production rollout review.
CONTEXT_CANDIDATES_ENABLED=false
CONTEXT_REVIEW_ENABLED=false
# Full immutable transcript snapshot limits. Oversize is a typed Context-only failure; never truncated.
CONTEXT_SOURCE_MAX_BYTES=2000000
CONTEXT_SOURCE_MAX_SEGMENTS=10000
# Smaller Codex extractor input boundary; first slice fails closed instead of chunking/truncating.
CONTEXT_EXTRACTOR_MAX_BYTES=500000
CONTEXT_EXTRACTOR_MAX_SEGMENTS=2000
# Disabled by default: no Feishu group history is read until explicitly approved and invoked.
PROJECT_CONTEXT_SYNC_ENABLED=false
PROJECT_CONTEXT_CHAT_IDS=
PROJECT_CONTEXT_SYNC_SINCE_DAYS=30
# Founder stream remains disabled. Local tests/plans do not authorize production reads or sends.
# Enable in order, with separate approval: capture -> analysis -> group delivery.
FOUNDER_STREAM_CAPTURE_ENABLED=false
FOUNDER_STREAM_ANALYSIS_ENABLED=false
FOUNDER_STREAM_GROUP_DELIVERY_ENABLED=false
FOUNDER_STREAM_MANUAL_QUERY_ENABLED=false
FOUNDER_STREAM_DAILY_RECONCILIATION_ENABLED=false
# Required when daily reconciliation is enabled. First run starts here; later runs continue from the last complete audit cursor.
FOUNDER_STREAM_RECONCILIATION_BOOTSTRAP_SINCE=
