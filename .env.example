NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=data/aijia-context-bridge.sqlite
# Phase 1A placeholders only. Replace the verification token before pnpm dev;
# non-test startup rejects the committed fixture token.
FEISHU_APP_ID=cli_fixture_only
FEISHU_APP_SECRET=fixture-not-a-secret
FEISHU_VERIFICATION_TOKEN=fixture-verification-token
FEISHU_ENCRYPT_KEY=fixture-encrypt-key
FEISHU_ALLOWED_CHAT_IDS=oc_a84d5b6ca478220d0a37964b50776edb
FEISHU_IVY_PRIVATE_CHAT_ID=oc_d851c3e986007dc0f97ab582bcb2e7c8
# Empty is fail-closed: replies identify Ivy but cannot authorize a Todo.
FEISHU_APPROVER_OPEN_IDS=
FEISHU_VOICE_TRANSCRIPTION_ENABLED=false
WEBHOOK_DEBOUNCE_SECONDS=300
CODEX_COMMAND=codex
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=medium
CODEX_WORKDIR=/tmp/aijia-codex-readonly
CODEX_TIMEOUT_SECONDS=120
CODEX_SUMMARIZER_MODE=fake
WORKER_ENABLED=false
WORKER_LEASE_SECONDS=180
WORKER_POLL_INTERVAL_MS=1000
# Disabled by default: no Feishu group history is read until explicitly approved and invoked.
PROJECT_CONTEXT_SYNC_ENABLED=false
PROJECT_CONTEXT_CHAT_IDS=
PROJECT_CONTEXT_SYNC_SINCE_DAYS=30
# Founder stream and all group-facing outputs remain off in local defaults.
FOUNDER_STREAM_CAPTURE_ENABLED=false
FOUNDER_STREAM_ANALYSIS_ENABLED=false
FOUNDER_STREAM_GROUP_DELIVERY_ENABLED=false
FOUNDER_STREAM_MANUAL_QUERY_ENABLED=false
FOUNDER_STREAM_WHITEBOARD_ENABLED=false
FOUNDER_STREAM_DAILY_RECONCILIATION_ENABLED=false
FOUNDER_STREAM_RECONCILIATION_BOOTSTRAP_SINCE=
